# Copy to .env.local and fill in. Only the first block is required to start the app.
# Variables starting with NEXT_PUBLIC_ are visible in the browser. Everything else is server-only.

# ── Required ────────────────────────────────────────────────────────────────────────────────
# From your Supabase project: Project Settings → API (or `supabase status` when running locally).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=      # the publishable (or legacy "anon") key
# Service-role / secret key. SERVER ONLY, never expose it. Needed for uploads, background jobs,
# imports, sharing and account deletion. Without it the app starts but can't store files.
SUPABASE_SECRET_KEY=
# Public address of this app (used in auth emails and the Telegram webhook).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Background processing ───────────────────────────────────────────────────────────────────
# Jobs are queued in the database and also kicked off right after each upload. For reliability run
# either `npm run worker` (long-lived server) or call /api/jobs/run on a schedule with this secret:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://your-app/api/jobs/run
CRON_SECRET=                               # any long random string (e.g. `openssl rand -hex 32`)

# ── AI answers (optional) ───────────────────────────────────────────────────────────────────
# Without these the app still works: search returns matching passages and files, not written answers.
# AI_PROVIDER: openai | openai-compatible | anthropic
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=                                  # e.g. a chat model name your provider offers
# AI_BASE_URL=                             # required for openai-compatible (Ollama, vLLM, Azure, …)
# Set to "local" ONLY if the endpoint is self-hosted. This is what unlocks the "Local AI" privacy mode.
# AI_PROVIDER_LOCALITY=cloud

# ── Semantic search (optional) ──────────────────────────────────────────────────────────────
# Must produce 1536-dimension vectors (the database column is vector(1536)).
EMBEDDING_MODEL=
# EMBEDDING_API_KEY=                       # defaults to AI_API_KEY
# EMBEDDING_BASE_URL=                      # defaults to AI_BASE_URL, then the OpenAI API
# EMBEDDING_PROVIDER_LOCALITY=             # defaults to AI_PROVIDER_LOCALITY

# ── Audio/video transcription and image OCR (optional) ──────────────────────────────────────
# TRANSCRIPTION_MODEL=                     # an OpenAI-compatible /audio/transcriptions model
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_BASE_URL=
# OCR_WITH_VISION_MODEL=true               # read text in images with the chat model (needs a vision model)

# ── Telegram bot (optional) ─────────────────────────────────────────────────────────────────
# Create a bot with @BotFather. Then run:  npm run telegram:webhook -- https://your-domain
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=                     # without the @
TELEGRAM_WEBHOOK_SECRET=                   # any long random string; Telegram echoes it on every call

# ── Malware scanning (optional) ─────────────────────────────────────────────────────────────
# Point at a ClamAV daemon (clamd). When set, uploads that can't be scanned are REJECTED, not allowed.
# CLAMAV_HOST=
# CLAMAV_PORT=3310

# ── Limits (optional; defaults shown) ───────────────────────────────────────────────────────
# MAX_UPLOAD_BYTES=2147483648              # largest single file (2 GB)
# DEFAULT_QUOTA_BYTES=5368709120           # per-user storage (5 GB)
# MAX_EXTRACT_BYTES=52428800               # larger files are indexed by name/metadata only (50 MB)
# MAX_IMPORT_BYTES=209715200               # largest chat export (200 MB)
# MAX_EXTRACTED_CHARS=2000000
# SIGNED_URL_SECONDS=60                    # lifetime of file preview/download links

# ── Tests only ──────────────────────────────────────────────────────────────────────────────
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
